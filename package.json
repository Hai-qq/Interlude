{
  "name": "interlude",
  "productName": "Interlude",
  "version": "0.27.0",
  "description": "间歇 · 本地桌面活动提醒",
  "author": "Interlude contributors",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "test:e2e": "node scripts/panel-qa.mjs",
    "preview:native": "npm run build && node scripts/preview-native.mjs",
    "preview:web": "vite --host 127.0.0.1 --port 5173",
    "licenses": "node scripts/licenses.mjs"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hai-qq/Interlude.git"
  },
  "bugs": {
    "url": "https://github.com/Hai-qq/Interlude/issues"
  },
  "homepage": "https://github.com/Hai-qq/Interlude#readme",
  "engines": {
    "node": ">=24"
  }
